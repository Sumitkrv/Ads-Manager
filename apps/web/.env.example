# Leave blank to use the same-origin /api path and Vite development proxy.
VITE_API_BASE_URL=
VITE_CAMPAIGN_GENERATION_MODE=simulation
# Local development defaults to the Supabase stack started by `npx supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# `npm run dev` fills this from `npx supabase status --output env` without printing it.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
