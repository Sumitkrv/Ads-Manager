APP_ENV=development
ADS_EXECUTION_MODE=demo
CAMPAIGN_GENERATION_MODE=simulation
# Live AI campaign text generation remains opt-in and requires both server-only values below.
OPENAI_API_KEY=
OPENAI_CAMPAIGN_MODEL=
CREATIVE_EXECUTION_MODE=local
BILLING_MODE=simulation
# Optional local-only trusted simulation operator allowlist (user UUIDs).
# Admin endpoints stay disabled unless the API runs in development on loopback.
BILLING_DEMO_ADMIN_USER_IDS=
API_HOST=127.0.0.1
API_PORT=4010
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# Local development defaults to the Supabase stack started by `npx supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Used only by narrowly scoped OAuth callback RPCs. Never expose to Vite.
SUPABASE_SERVICE_ROLE_KEY=

# Fixed callback return destination; callbacks never accept a user supplied URL.
INTEGRATIONS_APP_RETURN_URL=http://127.0.0.1:5180/app/integrations

# Supply a versioned JSON key ring from the deployment secret manager.
# Each value must be base64 encoding of exactly 32 random bytes.
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION=v1
INTEGRATION_CREDENTIAL_KEYS_JSON=

# Google Ads server-only OAuth and API configuration.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://127.0.0.1:4010/api/integrations/google_ads/callback
GOOGLE_ADS_API_VERSION=v26

# Meta Ads server-only OAuth and Marketing API configuration.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:4010/api/integrations/meta_ads/callback
META_GRAPH_API_VERSION=v26.0
META_LOGIN_CONFIG_ID=
